{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.test.com/events/v1/derived-event.schema.json",
  "title": "Generic test event",
  "description": "Represents a generic test event",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://schemas.test.com/events/v1/base-event.schema.json"
    }
  ],
  "properties": {
    "timestamp": {
      "description": "Event publication time in milliseconds since the UNIX epoch (January 1, 1970 00:00:00 UTC)",
      "type": "integer"
    },
    "content": {
      "description": "The content of the event.",
      "$ref": "https://schemas.test.com/objects/v1/object.schema.json"
    }
  },
  "required": [
    "timestamp",
    "content"
  ],
  "examples": [
    {
      "id": "urn:event:1234567890",
      "name": "my event",
      "timestamp": 1622548800000,
      "content": {
        "id": "urn:object:12345",
        "name": "my object",
        "code": "ABC123"
      }
    }
  ]
}
