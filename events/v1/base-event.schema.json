{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.test.com/events/v1/base-event.schema.json",
  "title": "Generic test event",
  "description": "Represents a generic test event",
  "type": "object",
  "properties": {
    "id": {
      "description": "The event unique identifier",
      "type": "string"
    },
    "name": {
      "description": "A name used to describe the event type being raised",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name"
  ],
  "examples": [
    {
      "id": "urn:event:1234567890",
      "name": "my event"
    }
  ]
}
