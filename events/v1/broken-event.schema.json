{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.test.com/events/v1/broken-event.schema.json",
  "title": "Generic test event",
  "description": "Represents a generic test event",
  "type": "object",
  "properties": {
    "id": {
      "description": "The event unique identifier",
      "type": "string"
    },
    "name": {
      "description": "A name used to describe the event type being raised",
      "type": "string"
    },
    "timestamp": {
      "description": "Event publication time in milliseconds since the UNIX epoch (January 1, 1970 00:00:00 UTC)",
      "type": "integer"
    },
    "content": {
      "description": "The content of the event.",
      "$ref": "https://schemas.test.com/objects/v1/object.schema.json"
    }
  },
  "required": [
    "id",
    "name",
    "timestamp",
    "content"
  ],
  "examples": [
    {
      "id": "urn:event:1234567890",
      "banana": "my event",
      "timestamp": 1622548800000,
      "content": {
        "id": "urn:object:12345",
        "goat": "my object"
      }
    }
  ]
}
