{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.test.com/objects/v1/object.schema.json",
  "title": "Generic test object",
  "description": "Represents a generic test object",
  "type": "object",
  "properties": {
    "id": {
      "description": "The unique identifier",
      "type": "string"
    },
    "name": {
      "description": "A name used to describe the object",
      "type": "string"
    },
    "code": {
      "description": "A code used to identify the object",
      "type": "string",
      "pattern": "^[A-Z]{3}[0-9]{3}$"
    }
  },
  "required": [
    "id",
    "name",
    "code"
  ],
  "examples": [
    {
      "id": "urn:object:1234567890",
      "name": "my object",
      "code": "ABC123"
    }
  ]
}
