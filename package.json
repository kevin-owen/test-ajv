{
  "name": "test-ajv",
  "version": "1.0.0",
  "description": "JSON Schema validation for test-ajv",
  "scripts": {
    "validate": "node .github/scripts/validate-schemas.js",
    "validate:all": "cross-env SCHEMA_PATH=\"**/*.schema.json\" node .github/scripts/validate-schemas.js",
    "validate:events": "cross-env SCHEMA_PATH=\"events/**/*.schema.json\" node .github/scripts/validate-schemas.js",
    "validate:objects": "cross-env SCHEMA_PATH=\"objects/**/*.schema.json\" node .github/scripts/validate-schemas.js"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "glob": "^10.3.10"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
